formulas:
  Untitled: ""
views:
  - type: table
    name: Таблица
    filters:
      and:
        - file.inFolder("BookShelf")
    order:
      - file.name
      - status
      - category
    sort:
      - property: formula.Untitled
        direction: ASC
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 268
      note.status: 194
      note.category: 128
